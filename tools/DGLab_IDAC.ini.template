; ============================================================================
; DGLab_IDAC 配置模板 —— 带注释的权威版本
; ============================================================================
; 用法: 拷到 mod 目录并改名为 DGLab_IDAC.ini
;   <游戏>\WindowsNoEditor\GameProject\Binaries\Win64\ue4ss\Mods\DGLab_IDAC\dlls\DGLab_IDAC.ini
;
; 发布包里这个文件已经放在正确位置并叫 DGLab_IDAC.ini, 一般不需要拷。
;
; 改配置前想先离线体检, 别靠读日志猜(conftest.exe 是仓库里的开发工具, 发布包不含):
;   tools\conftest.exe "<上面那个 ini 的完整路径>"
; 它会直接判定"会连真实设备吗 / 设备会有刺激吗"。dry_run 写错的表现是
; 日志一切正常、只是少做了一件事, 光看日志看不出来。
;
; 两个格式硬要求(都踩过):
;   1) 行尾必须是 CRLF。纯 LF 的 INI 会被 Win32 的 GetPrivateProfileStringA
;      整个读空, 配置静默回落到内置默认值, 日志里看不出任何异常。
;   2) 注释符是 ';' 不是 '#'。值里的 ';' 及其后内容会被剥掉(可用于行内注释)。
;
; 解析器是 Win32 GetPrivateProfileStringA/GetPrivateProfileIntA,
; 所以段名与键名大小写不敏感。
; ============================================================================

[general]
; enable  : 1=加载本 mod, 0=完全不加载。数值 0 或 1。
; verbose : 1=日志详细, 0=只留关键行。数值 0 或 1。
enable=1
verbose=1

[link]
; mode : 输出到哪。数值是字符串:
;        disabled  不连任何设备(纯干跑, 但仍然跑管线与日志) —— 排障首选
;        ble       PC 直接做 BLE 中央设备连郊狼主机, 不需要手机 ← 生产用法
;        websocket 暂未实现。官方的 SOCKET 方案(V4 中继)仍然要让手机 APP
;                  参与: 本程序做"控制器"连中继服务器, 手机 APP 再连过来。
;                  详见 docs/research-dglab-transport.md 第 1.2 节
; protocol : 郊狼协议版本。目前只支持 v3。数值是字符串。
mode=ble
protocol=v3

[ble]
; device_name : 设备广播名, 郊狼主机是 47L121000。数值是字符串。
; reconnect_ms / connect_timeout_ms : 断线重连间隔 / 连接超时, 单位毫秒。
; service_uuid / write_uuid / notify_uuid : 留空则用郊狼标准 UUID。
;   注意: IIDFromString 要求带花括号, 本程序两种写法都接受。
device_name=47L121000
reconnect_ms=3000
connect_timeout_ms=15000

[output]
; frame_ms : 一帧多少毫秒。数值是毫秒的整数, 郊狼协议节拍是 100。
;   ★ BLE 直连时这个值固定 100, 填别的会打一条 WARN 并按 100 处理 ★
;   原因: 一帧正好覆盖 4x25ms, 设备也按 100ms 的窗口回执; 改它不会让设备变快,
;   只会让管线的提交节拍与设备的消费节拍错位。
; 脉冲频率(Pulse frequency value)的语义是反的: 数值越大 = 单元时长越长 =
;   电气频率越低 = 手感越"敦实"。
; pulse_freq_base : 保留键, **当前程序不使用**(只读进 Config, 不参与计算)。
;   写 30 只是为了和旧配置保持兼容。
; pulse_freq_min : 实际使用的频率值。数值 10~240。
;   pulse_freq_track 默认 0 => 频率恒定等于 pulse_freq_min, 与信号无关。
; pulse_freq_max : 只有当 pulse_freq_track > 0 时才起作用(信号越大越靠向它)。
;   这个键不在本模板里出现, 需要时自己加一行 pulse_freq_track=0.0~1.0。
; 想调"实/麻"改 pulse_freq_min(必要时加 pulse_freq_track); 想调"强弱"改各通道的
;   base_strength 与 level, 与频率无关。
frame_ms=100
pulse_freq_base=30
pulse_freq_min=10
pulse_freq_max=60

; 自动增益: 力反馈原始值的实际范围随车/赛道/工况变化很大, 用动态峰值当
; 归一化上界, 幅值才能铺满 0..1。
; auto_gain : 1=开, 0=关(退回各通道自己的 in_max)。数值 0 或 1。
; gain_attack_sec : 峰值上升时, 增益跟到峰值所需秒数。数值是秒, 浮点。
; gain_release_sec : 峰值回落时, 增益衰减的时间常数。数值是秒, 浮点。
; gain_floor : 动态上界的下限。数值是整数, 别取 0(会除零)。
; gain_ceiling : 动态上界的上限, 不得超过物理满量程。数值是整数。
; gain_idle_reset_sec : 无信号多久后放弃当前峰值重新起步。数值是秒, 浮点。
auto_gain=1
gain_attack_sec=0.7
gain_release_sec=8.0
gain_floor=24
gain_ceiling=127
gain_idle_reset_sec=3.0

; ── 通道对应关系 ────────────────────────────────────────────────────────
; A = 郊狼主机的 A 通道(左侧电极), B = B 通道(右侧电极)。
; 每个通道的 source 决定它接哪个游戏数据。以下是全部可选值:
;   torque    方向盘回正扭矩的幅值(= abs(游戏扭矩), 域 0..127), 实测最活跃
;             (回调约 1000 次/轮)。左转与右转都输出力 —— 注意取的是**幅值**,
;             左右方向在波形上是同一个信号, 本程序不区分。
;   viscosity 转向阻尼, 几乎全程有值 —— 实测约 10900 次/轮
;             ⚠ 不推荐作为输出源: 强制退出比赛回到菜单后, 游戏可能把阻尼停在一个
;             可感的值上; 这个回调只在值变化时触发, 停住的值会一直输出, 直到下一次变化。
;   vibration 振动/路肩, 只在压路肩/碰撞等判定发生时给一次 —— 实测约 160 次/轮,
;             属于"事件型"手感, 大部分时间是安静的
;   servo     游戏伺服的开关状态(0 或 1), 调试用
;   const     恒为 0(没有实际输出) —— 调试用
; 想要"恒定输出、不看游戏数据", **不是**把 source 写成 static(那会被当成未知
;   源, 输出恒为 0); 正确做法是把 map_mode 写成 constant, 此时输出等于 level。
; 另有 torque_signed: 试图按 torque 的 direction 参数恢复符号。**当前不要用** ——
;   逆向证实那个参数不是"左右", 而是齿轮/档位索引(域 0..255); 它取 -1 只表示
;   "算出的扭矩为正", 其余情况装的是档位值。用它恢复符号得不到方向。
;   依据: re/indrun_hook_mechanics.md 第 4.1 与第 5 节。
; 建议 A 用 torque。
; 想分辨"是哪个通道在动", 让两个通道的 base_strength 不同即可。

[channel_a]
; enable : 1=本通道输出, 0=本通道完全不输出。数值 0 或 1。
; source : 见上面的可选值表。数值是字符串。
; map_mode : 原始值怎么变成 0~1。数值是字符串, 只认下面这几个(别的一律打 WARN
;            后按 abs_linear 处理):
;            abs_linear 取绝对值后线性映射(左右转向都输出) ← 推荐; abslinear 同义
;            linear     保留符号线性映射(负值先被钳到 0, 所以反向=不输出)
;            sqrt       开方, 小信号被抬高(轻手感更明显); 负值同样先钳到 0
;            square     平方, 小信号被压低(手感更"沉")
;            threshold  低于 in_min 直接归零, 之上按 level 线性
;            constant   忽略 source 与游戏数据, 输出恒为 level
;            注意: 没有 abs_sqrt 这个值(历史上文档写错过, 程序从来不认)。
; in_min : 映射下界, 即"原始值多少对应输出 0"。数值 0~200 的整数。
; in_max : 映射上界的静态值, 即"原始值多少算满"。数值 1~200 的整数。
;          注意 auto_gain=1 时它只在启动瞬间当初始上界, 之后由增益包络接管。
; level  : 本通道整体幅度系数。数值 0.0~1.0; 1.0=不衰减。
;          只在 strength_source=level 时影响通道强度, 但始终影响脉冲振幅。
; base_strength : 本通道的强度, 即设备上的"音量"。数值 0~200 的整数; 它先被
;          [safety] clamp_strength / max_strength 截断(取三者最小), 再下发给设备。
;          0 = 本通道不输出。15 属于很轻的档位。
; strength_source : 数值是字符串:
;          static 强度恒为 base_strength, 游戏动态全部体现在脉冲振幅上 ← 推荐
;          level  强度跟着映射值走, 用下面的 strength_margin 设下限比例
;          (两者手感差别明显, 想 A/B 对比就只改这一行)
; strength_margin : 只在 strength_source=level 时有意义。数值 0.0~1.0;
;          0.2 表示信号为 0 时强度也有 base_strength 的 20%, 手感连续不留死区。
enable=1
source=torque
map_mode=abs_linear
in_min=0
in_max=127
level=1.0
base_strength=15
strength_source=static
strength_margin=0.0

[channel_b]
; 各键含义与取值范围同 [channel_a]。
; 当前接 vibration(事件型)。不建议改成 viscosity(原因见上面的来源表)。
enable=1
source=vibration
map_mode=abs_linear
in_min=0
in_max=127
level=0.6
base_strength=10
strength_source=static
strength_margin=0.0

[safety]
; 强度有三层, 别混: 通道自己的 base_strength(想用多少) -> 本段 clamp_strength(软件
; 自我约束) -> max_strength(设备侧 BF 软限位)。实际下发的通道强度 =
; min(base_strength 算出的值, clamp_strength, max_strength)。
; max_strength : ★ 设备侧 ★ 全局最大强度。连接后作为 BF 软限位写进郊狼主机(A、B 都设成
;                这个值), 设备断电保存; 手拧设备滚轮也突破不了它。数值 0~200 的整数。
;                两个通道共用这一个值。换设备/重连后会自动重发。
; clamp_strength : ★ 软件侧 ★ 自我约束上限, 本 mod 算完通道强度后自己截断。
;                实际生效上限取 min(clamp_strength, max_strength); 配得比
;                max_strength 还大会打 WARN 并自动降到 max_strength。
; slew_per_second : 每秒最多变化多少档强度。数值是整数档/秒;
;                40 表示每 100 ms 最多变 4 档, 从 0 爬到 15 约需 375 ms。
; watchdog_ms : 看门狗。超过这么多毫秒没有新的帧送到传输层, 就改发静默帧
;                (强度 0), 防止管线卡死时设备一直保持上一个强度。数值是毫秒。
;                判据是"管线有没有在提交帧", 不是"力反馈回调有没有来" ——
;                回调是边沿触发的, 力不变时不回调属于正常现象。
;                配置加载时会被抬到至少 3 倍的 frame_ms, 免得正常抖动误触发;
;                超过 2000 ms 会被压回 2000(再长就失去兜底意义)。
;                它只兜底"数据流断了", 真正的力道上限仍然是 max_strength
;                与设备侧的 BF 软限位。
; viscosity_hold_ms : viscosity 源的保持超时(毫秒)。数值 0 = 关闭; 其他值 500~10000。
;                viscosity 的回调是"值变了才回调", 退出比赛回菜单后游戏可能把阻尼
;                停在一个非零值上不再更新, 那个值会被一直输出(实测脉冲 42/100,
;                人体无感但设备指示灯亮着)。超过这个毫秒数没有新回调就把该通道的
;                原始值按 0 处理, 源一更新立刻恢复。
;                ★ 副作用: 发车倒计时、暂停等原地不动的时段也会被归零 ★
;                只影响 source=viscosity / viscosity_a 的通道。
; torque_hold_ms / vibration_hold_ms : torque / vibration 源各自的保持超时(毫秒)。
;                数值 0 = 关闭; 其他值 500~20000。
;                ★ 默认 10000, 不是 2000 ★ —— 实测正常驾驶中"方向盘稳住不动"会让
;                torque 的回调停 3~7 秒(期间粘度仍在每秒更新, 说明车在动, 这次保持
;                是真的)。2 秒的超时会在真实过弯里把力砍掉, 所以单源超时放到 10 秒,
;                只用来兜"这个源彻底不更新"的底。
; silent_mute_ms : 三个源"同时"停更超过这么多毫秒, 所有已启用通道的原始值都按 0。
;                数值 0 = 关闭; 其他值 200~10000。
;                它抓的是"游戏不再喂任何力反馈数据"(退出比赛、对战匹配成功打断
;                计时赛): 实测这种齐停在 100 分钟里只出现 22 次, 最短 48 秒, 正常
;                驾驶中一次都没有 —— 所以 1 秒足够快, 也不会误伤真实保持。
;                一级判定按 1 秒生效, 上面两个 *_hold_ms 只在它之后兜底。
; zero_when_servo_off : 1=游戏伺服未就绪时强制归零, 0=不归零。数值 0 或 1。
; warmup_ms : 启动后多久内不输出, 给设备与链路留握手时间。数值是毫秒。
; dry_run : ★ 硬开关 ★ 1=不管 [link] mode 写什么, 一律走空输出, 绝不碰设备;
;                0=允许真实输出。数值 0 或 1。
;           这是"物理上不可能电到人"的唯一开关, 优先于 [link] mode。
;           用途是把"加载/挂钩"和"真实输出"分开验证:
;             写 1 —— 只验证加载和挂钩(不建立 BLE, 设备不会连上);
;             验证链路用 0, 并先不接电极(看日志里的 B1 回执即可)。
max_strength=30
clamp_strength=30
slew_per_second=40
watchdog_ms=500
zero_when_servo_off=1
warmup_ms=5000
viscosity_hold_ms=2000
; 10000 = 单源兜底(实测真实保持最长 7.0 s, 所以放到 10 s); 0 = 关闭。
torque_hold_ms=10000
vibration_hold_ms=10000
; 1000 = 三源齐停 1 秒就静音(实测齐停最短 48 s); 0 = 关闭。
silent_mute_ms=1000
dry_run=0

[debug]
; hook : 1=挂钩 IndRun.dll 取真实力反馈, 0=只跑内置测试数据。数值 0 或 1。
;        崩溃排障先关这个: 不崩就说明问题在挂钩, 还崩就说明在别处。
hook=1
